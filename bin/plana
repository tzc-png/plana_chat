#!/usr/bin/env bash
# plana — 普拉娜 Telegram 机器人服务管理 CLI
#
# 用法：plana {on|off|system_on|system_off|status|help}
# 本脚本位于 <项目根>/bin/ 下，会自动定位项目根目录。

set -u

PLANA_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VENV_PY="$PLANA_ROOT/.venv/bin/python"
RUNNER="$PLANA_ROOT/run_telegram.py"
DATA_DIR="$PLANA_ROOT/data"
PID_FILE="$DATA_DIR/plana.pid"
LOG_FILE="$DATA_DIR/plana.log"
SERVICE="plana-chat"
TTS_SOCK="/tmp/plana_tts.sock"

# ── 状态判断 ──────────────────────────────────────────────────────────────────
is_running() {
    [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

systemd_active() {
    systemctl is-active --quiet "$SERVICE" 2>/dev/null
}

# ── 停止非 systemd 的后台实例（含语音引擎）──────────────────────────────────
stop_bg() {
    if is_running; then
        kill "$(cat "$PID_FILE")" 2>/dev/null
        for _ in $(seq 1 10); do
            is_running || break
            sleep 0.5
        done
    fi
    # 兜底：按进程名清理（不会匹配到本脚本，因脚本命令行不含这些字符串）
    pkill -f "run_telegram.py" 2>/dev/null || true
    pkill -f "plana_tts_server.py" 2>/dev/null || true
    rm -f "$PID_FILE" "$TTS_SOCK"
}

# ── 帮助 ──────────────────────────────────────────────────────────────────────
usage() {
    cat <<'EOF'
  on          后台启动机器人（非 systemd 模式，日志见 data/plana.log）
  off         停止机器人并释放语音引擎
  quiet       切换为 quiet 模式（免打扰，关闭主动问候/追问）
  active      切换为 active 模式（总是追问）
  default     切换为 default 模式（追问动态决策，默认）
  system_on   安装并启用 systemd 服务（开机自启，需 sudo）
  system_off  停止并禁用 systemd 服务（需 sudo）
  status      查看运行状态
  help        显示本帮助
EOF
}

case "${1:-}" in
  on)
    if systemd_active; then
      echo "错误：systemd 服务已在运行，请先执行 plana system_off 再 plana on" >&2
      exit 1
    fi
    if is_running; then
      echo "plana 已在运行（PID $(cat "$PID_FILE")）"
      exit 0
    fi
    mkdir -p "$DATA_DIR"
    # setsid 彻底脱离终端，关终端/重启不依赖当前 shell
    setsid "$VENV_PY" "$RUNNER" >> "$LOG_FILE" 2>&1 < /dev/null &
    echo $! > "$PID_FILE"
    sleep 1
    if is_running; then
      echo "plana 已启动（PID $(cat "$PID_FILE")）"
      echo "日志：$LOG_FILE"
    else
      echo "启动失败，请查看日志：$LOG_FILE" >&2
      rm -f "$PID_FILE"
      exit 1
    fi
    ;;

  off)
    stop_bg
    echo "plana 已关闭（含语音引擎）"
    ;;

  quiet)
    mkdir -p "$DATA_DIR"
    echo '{"mode": "quiet"}' > "$DATA_DIR/state.json"
    echo "plana 已切换为 quiet 模式（关闭主动问候/追问）"
    ;;

  active)
    mkdir -p "$DATA_DIR"
    echo '{"mode": "active"}' > "$DATA_DIR/state.json"
    echo "plana 已切换为 active 模式（总是追问）"
    ;;

  default)
    mkdir -p "$DATA_DIR"
    echo '{"mode": "default"}' > "$DATA_DIR/state.json"
    echo "plana 已切换为 default 模式（追问动态决策）"
    ;;

  system_on)
    stop_bg  # 先停掉后台实例，避免与 systemd 双开
    UNIT="/etc/systemd/system/$SERVICE.service"
    sudo tee "$UNIT" > /dev/null <<EOF
[Unit]
Description=Plana Telegram Chat Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=$(whoami)
WorkingDirectory=$PLANA_ROOT
ExecStart=$VENV_PY $RUNNER
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
    sudo systemctl daemon-reload
    sudo systemctl enable --now "$SERVICE"
    echo "systemd 服务已安装并启动：$SERVICE"
    systemctl --no-pager -l status "$SERVICE" | head -n 12
    ;;

  system_off)
    sudo systemctl disable --now "$SERVICE" 2>/dev/null || true
    sudo rm -f "/etc/systemd/system/$SERVICE.service"
    sudo systemctl daemon-reload
    pkill -f "plana_tts_server.py" 2>/dev/null || true
    rm -f "$TTS_SOCK"
    echo "systemd 服务已停止并移除"
    ;;

  status)
    if systemd_active; then
      echo "运行状态：运行中"
      echo "运行方式：systemd 服务（$SERVICE）"
    elif is_running; then
      echo "运行状态：运行中"
      echo "运行方式：后台进程（PID $(cat "$PID_FILE")）"
    else
      echo "运行状态：未运行"
      if systemctl is-enabled --quiet "$SERVICE" 2>/dev/null; then
        echo "运行方式：systemd 服务（已启用，当前未运行）"
      else
        echo "运行方式：未配置"
      fi
    fi
    if pgrep -f "plana_tts_server.py" > /dev/null 2>&1; then
      echo "语音引擎：已加载"
    else
      echo "语音引擎：未加载（首次发语音时自动启动）"
    fi
    "$VENV_PY" - "$PLANA_ROOT" "$DATA_DIR" <<'PYEOF'
import json, re, sys, sqlite3
from pathlib import Path
root = Path(sys.argv[1]); data_dir = Path(sys.argv[2])
cfg = (root / "config.yaml").read_text(encoding="utf-8")

# 模式
m = re.search(r'\nmode:\s*(\w+)', cfg)
default_mode = m.group(1) if m else "default"
mode = default_mode
sf = data_dir / "state.json"
if sf.exists():
    try:
        mode = json.loads(sf.read_text()).get("mode", default_mode)
    except Exception:
        pass
desc = {"default": "动态追问", "active": "总是追问", "quiet": "免打扰"}.get(mode, "?")
print(f"模式：{mode}（{desc}）")

# 关系（好感度 + 阶段）+ 挂起话题
m_db = re.search(r'db_path:\s*"([^"]+)"', cfg)
db_path = root / (m_db.group(1) if m_db else "data/history.db")
m_ids = re.search(r'chat_ids:\s*\[([^\]]+)\]', cfg)
user_id = None
if m_ids:
    ids = [x.strip() for x in m_ids.group(1).split(',') if x.strip()]
    if ids:
        user_id = ids[0]

def disp(c):
    return c.replace("普拉娜jealous", "黑化").replace("普拉娜sulky", "吃醋")

try:
    conn = sqlite3.connect(str(db_path)); conn.row_factory = sqlite3.Row
    if user_id:
        rel = conn.execute("SELECT affinity, stage FROM relationship WHERE user_id=?", (user_id,)).fetchone()
        topics = conn.execute(
            "SELECT content FROM topics WHERE user_id=? AND status='open' ORDER BY importance DESC, id DESC LIMIT 5",
            (user_id,),
        ).fetchall()
    else:
        rel = conn.execute("SELECT affinity, stage FROM relationship ORDER BY user_id LIMIT 1").fetchone()
        topics = conn.execute("SELECT content FROM topics WHERE status='open' ORDER BY importance DESC, id DESC LIMIT 5").fetchall()
    conn.close()
    if rel:
        print(f"关系：{rel['stage']}（好感度 {rel['affinity']}）")
    else:
        print("关系：陌生（好感度 0）")
    if topics:
        print("挂起话题：" + "、".join(disp(t['content']) for t in topics))
    else:
        print("挂起话题：（无）")
except Exception as e:
    print(f"关系：—（{e}）")
PYEOF
    ;;

  help|--help|-h|"")
    usage
    ;;

  *)
    echo "未知指令：${1:-}" >&2
    usage
    exit 1
    ;;
esac
